[Unit]
Description=AI Voice Changer Spring Boot API
After=network-online.target aivoice-ai.service

[Service]
User=aivoice
WorkingDirectory=/opt/aivoice/backend
EnvironmentFile=/opt/aivoice/server.env
ExecStart=/usr/bin/java -jar /opt/aivoice/backend/target/aivoice-backend-1.0.0.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
